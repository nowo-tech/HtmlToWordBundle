{% extends 'base.html.twig' %}

{% block title %}HtmlToWord — JSON configuration (Symfony 8){% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Custom profile & HTML',
        intro: 'Misma forma que una entrada bajo nowo_html_to_word.profiles en YAML. Pega lo que guardarías en base de datos (columna JSON) o usa para pruebas.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Merge with YAML or this config only', kind: 'detail'} %}
        {% block section_body %}
            <p>
                <strong>Merge with YAML</strong> — <code class="nowo-ui-code">convertWithOptions($html, $options, $profile)</code>:
                merge order = YAML <code class="nowo-ui-code">default</code> profile + selected named profile + your JSON (deepest wins).
            </p>
            <p>
                <strong>This config only</strong> — <code class="nowo-ui-code">convertWithInlineProfile($html, $options)</code>:
                no YAML merge; use when the full profile lives in a database.
            </p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Cabecera y pie en el Word', intro: 'Las claves son las mismas que en nowo_html_to_word.profiles.* del bundle.', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><code class="nowo-ui-code">header</code>: <code class="nowo-ui-code">enabled</code>, <code class="nowo-ui-code">text</code>, <code class="nowo-ui-code">logo</code> (ruta absoluta a raster), <code class="nowo-ui-code">logo_width</code> (px CSS), <code class="nowo-ui-code">show_page_number</code>, <code class="nowo-ui-code">different_first_page</code>.</li>
                <li><code class="nowo-ui-code">footer</code>: <code class="nowo-ui-code">enabled</code>, <code class="nowo-ui-code">text</code>, <code class="nowo-ui-code">show_page_number</code> (PhpWord inserta el campo de página con <code class="nowo-ui-code">{PAGE}</code>), <code class="nowo-ui-code">different_first_page</code>.</li>
                <li>En JSON pegado en el navegador <strong>no</strong> se resuelve <code class="nowo-ui-code">%kernel.project_dir%</code>: el ejemplo precargado usa ya la ruta absoluta al logo del demo.</li>
                <li>Perfil YAML <code class="nowo-ui-code">membrete</code> en la demo principal reproduce el mismo concepto sin pasar por este formulario.</li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sample header logo (web + DOCX)', kind: 'detail'} %}
        {% block section_body %}
            <p><img src="{{ asset('demo-assets/demo-logo.png') }}" alt="Sample logo used in DOCX header when configured" width="160" height="160"></p>
            <p class="nowo-ui-muted">
                Static file <code class="nowo-ui-code">public/demo-assets/demo-logo.png</code>. Profiles such as <code class="nowo-ui-code">membrete</code> reference it via
                <code class="nowo-ui-code">header.logo</code>; HtmlToWordBundle embeds it in the Word header when the path is readable and the bytes look like PNG/JPEG/GIF/WebP.
                Body HTML below can still include <code class="nowo-ui-code">&lt;img&gt;</code> tags — those are independent from this logo.
            </p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Convert', kind: 'form', testid: 'demo-custom-config', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'custom-config-form', class: 'nowo-ui-form'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.mode) }}
                <div id="profile-row" data-demo-mode-field="{{ form.mode.vars.full_name }}" data-demo-profile-field="{{ form.profile.vars.id }}">
                    {{ form_row(form.profile) }}
                </div>
                {{ form_row(form.html) }}
                {{ form_row(form.config_json) }}
                <p class="nowo-ui-muted">Referencia: JSON mínimo del perfil YAML «{{ default_profile }}» (solo lo que exporta la config)</p>
                <pre class="nowo-ui-code-block" tabindex="0">{{ sample_config_json }}</pre>
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <a href="{{ path('demo_home') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to main demo</a>
            <button type="submit" form="custom-config-form" class="nowo-ui-btn nowo-ui-btn--primary">Download .docx</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('demo-assets/custom-config.js') }}" defer></script>
{% endblock %}
