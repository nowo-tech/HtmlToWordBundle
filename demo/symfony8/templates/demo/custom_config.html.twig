{% extends 'base.html.twig' %}

{% block title %}HtmlToWord — JSON configuration (Symfony 8){% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Custom profile & HTML',
        intro: 'Misma forma que una entrada bajo nowo_html_to_word.profiles en YAML. Pega lo que guardarías en base de datos (columna JSON) o usa para pruebas.',
    }) }}
{% endblock %}

{% block body %}
  <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <p><strong>Merge with YAML</strong> — <code>convertWithOptions($html, $options, $profile)</code>:
      merge order = YAML <code>default</code> profile + selected named profile + your JSON (deepest wins).</p>
    <p><strong>This config only</strong> — <code>convertWithInlineProfile($html, $options)</code>:
      no YAML merge; use when the full profile lives in a database.</p>
  </div>

  <section class="nowo-ui-card">
    <div class="nowo-ui-card__body">
      <h2 class="nowo-ui-card__title">Cabecera y pie en el Word</h2>
      <p>Las claves son las mismas que en <code>nowo_html_to_word.profiles.*</code> del bundle:</p>
      <ul>
        <li><code>header</code>: <code>enabled</code>, <code>text</code>, <code>logo</code> (ruta absoluta a raster), <code>logo_width</code> (px CSS), <code>show_page_number</code>, <code>different_first_page</code>.</li>
        <li><code>footer</code>: <code>enabled</code>, <code>text</code>, <code>show_page_number</code> (PhpWord inserta el campo de página con <code>{PAGE}</code>), <code>different_first_page</code>.</li>
        <li>En JSON pegado en el navegador <strong>no</strong> se resuelve <code>%kernel.project_dir%</code>: el ejemplo precargado usa ya la ruta absoluta al logo del demo.</li>
        <li>Perfil YAML <code>membrete</code> en la demo principal reproduce el mismo concepto sin pasar por este formulario.</li>
      </ul>
    </div>
  </section>

  <section class="nowo-ui-card">
    <div class="nowo-ui-card__body">
      <h2 class="nowo-ui-card__title">Sample header logo (web + DOCX)</h2>
      <p>
        <img src="{{ asset('demo-assets/demo-logo.png') }}" alt="Sample logo used in DOCX header when configured" width="160" height="160">
      </p>
      <p class="nowo-ui-muted">
        Static file <code>public/demo-assets/demo-logo.png</code>. Profiles such as <code>membrete</code> reference it via
        <code>header.logo</code>; HtmlToWordBundle embeds it in the Word header when the path is readable and the bytes look like PNG/JPEG/GIF/WebP.
        Body HTML below can still include <code>&lt;img&gt;</code> tags — those are independent from this logo.
      </p>
    </div>
  </section>

  {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.mode) }}
    <div id="profile-row">
      {{ form_row(form.profile) }}
    </div>

    {{ form_row(form.html) }}
    {{ form_row(form.config_json) }}
    <details class="nowo-ui-card">
      <summary class="nowo-ui-card__title">Referencia: JSON mínimo del perfil YAML «{{ default_profile }}» (solo lo que exporta la config)</summary>
      <pre class="nowo-ui-code-block">{{ sample_config_json }}</pre>
    </details>

    {{ form_row(form.submit) }}
    <a href="{{ path('demo_home') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to main demo</a>
  {{ form_end(form) }}

  <script>
    const modeInline = document.querySelector('input[name="{{ form.mode.vars.full_name }}"][value="inline"]');
    function syncProfileRow() {
      const inline = modeInline.checked;
      document.getElementById('profile-row').style.display = inline ? 'none' : '';
      const sel = document.getElementById('{{ form.profile.vars.id }}');
      if (sel) { sel.disabled = inline; }
    }
    document.querySelectorAll('input[name="{{ form.mode.vars.full_name }}"]').forEach(function (radio) {
      radio.addEventListener('change', syncProfileRow);
    });
    syncProfileRow();
  </script>
{% endblock %}
