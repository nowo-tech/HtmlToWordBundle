{% extends 'base.html.twig' %}

{% block title %}HtmlToWord — demos (Symfony 8){% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'HtmlToWordBundle',
        intro: 'The configured engine is always phpword (PhpOffice). HTML is parsed with masterminds/html5, light sanitization, the bundle transformer chain, and PhpWord section setup (margins, orientation, header/footer). DOCX export is in-memory; League Flysystem is optional for other targets — this demo uses HTTP download only.',
    }) }}
{% endblock %}

{% block body %}
  <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>Same API, three calls:</strong> depending on the mode, the controller uses one of these
    <code>HtmlToWordConverterInterface</code> methods:
    <code>convertWithProfile()</code>, <code>convert()</code> (YAML <code>default</code> profile) or
    <code>convertWithOptions()</code> (merge options + profile). The internal pipeline is unchanged.
    <a href="{{ path('demo_custom_config') }}">Formulario JSON</a>
    — cabecera / pie de Word (<code>header</code> / <code>footer</code>), merge YAML o solo inline (<code>convertWithInlineProfile</code>).
  </div>

  <details class="nowo-ui-card">
    <summary class="nowo-ui-card__title">YAML profiles in this demo (different config, same builder)</summary>
    <div class="nowo-ui-card__body">
      <ul>
        <li><code>default</code>, <code>estricto</code> — <code>strict_mode</code> enabled.</li>
        <li><code>informe</code> — landscape + repeatable table header.</li>
        <li><code>membrete</code>, <code>pie_solo</code>, <code>carta_us</code> — cabecera/pie PhpWord y tamaño LETTER.</li>
        <li><a href="{{ path('demo_custom_config') }}"><code>/custom-config</code></a> — mismo esquema en JSON (ejemplo precargado con cabecera + pie).</li>
        <li><code>tablas_avanzado</code> vs <code>tablas_sin_repeat</code> — <code>tables.repeat_header_row</code>.</li>
        <li><code>imagen_ancha</code> — <code>images.max_width</code> / remote images.</li>
        <li><code>densidad</code> — long text/tables + stress filename.</li>
      </ul>
    </div>
  </details>

  {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.api) }}
    {{ form_row(form.profile) }}
    {{ form_widget(form.preset) }}

    <p class="nowo-ui-muted">Presets (fill the textarea)</p>
    <p>
      {% for id, _html in presets %}
        <button type="button" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" data-load-preset="{{ id }}" title="{{ preset_meta[id].stack|default('') }}">{{ id }}</button>
      {% endfor %}
    </p>

    {{ form_row(form.html) }}

    <table class="nowo-ui-data-table nowo-ui-data-table--compact">
      <caption>Preset → suggested profile + stack note</caption>
      <thead>
        <tr><th>Preset</th><th>Suggested profile</th><th>Stack / libraries</th></tr>
      </thead>
      <tbody>
        {% for id, meta in preset_meta %}
          <tr>
            <td><code>{{ id }}</code></td>
            <td><code>{{ meta.profile }}</code></td>
            <td>{{ meta.stack }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {{ form_rest(form) }}
  {{ form_end(form, {render_rest: false}) }}

  <script>
    const DEMO_PRESETS = {{ presets_json|raw }};
    document.querySelectorAll('[data-load-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-load-preset');
        const ta = document.getElementById('{{ form.html.vars.id }}');
        const pf = document.getElementById('{{ form.preset.vars.id }}');
        ta.value = DEMO_PRESETS[id] || '';
        pf.value = '';
        const sug = {{ preset_meta_json|raw }};
        if (sug[id] && sug[id].profile) {
          const sel = document.getElementById('{{ form.profile.vars.id }}');
          const opt = Array.from(sel.options).find(function (o) { return o.value === sug[id].profile; });
          if (opt) { sel.value = sug[id].profile; }
        }
      });
    });
  </script>
{% endblock %}
