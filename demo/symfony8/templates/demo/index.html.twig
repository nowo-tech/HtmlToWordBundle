{% extends 'base.html.twig' %}

{% block title %}HtmlToWord — demos (Symfony 8){% endblock %}

{% block body %}
  <h1>HtmlToWordBundle <span class="text-secondary fs-5">(Symfony 8)</span></h1>
  <p class="lead">
    The configured engine is always <strong><code>phpword</code></strong> (PhpOffice). HTML is parsed with
    <strong>masterminds/html5</strong>, light sanitization, the bundle <strong>transformer</strong> chain, and
    PhpWord section setup (margins, orientation, header/footer). DOCX export is in-memory;
    <strong>League Flysystem</strong> is optional for other targets — this demo uses HTTP download only.
  </p>

  <div class="alert alert-info small mb-3">
    <strong>Same API, three calls:</strong> depending on the mode, the controller uses one of these
    <code>HtmlToWordConverterInterface</code> methods:
    <code>convertWithProfile()</code>, <code>convert()</code> (YAML <code>default</code> profile) or
    <code>convertWithOptions()</code> (merge options + profile). The internal pipeline is unchanged.
    <span class="d-block mt-2 mb-0"><a href="{{ path('demo_custom_config') }}">Full profile JSON form</a>
      — YAML merge or inline only (<code>convertWithInlineProfile</code>), e.g. config stored in a database.</span>
  </div>

  <div class="accordion mb-4" id="profiles-acc">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#profiles-collapse">
          YAML profiles in this demo (different config, same builder)
        </button>
      </h2>
      <div id="profiles-collapse" class="accordion-collapse collapse" data-bs-parent="#profiles-acc">
        <div class="accordion-body small">
          <ul class="mb-0">
            <li><code>default</code>, <code>estricto</code> — <code>strict_mode</code> enabled.</li>
            <li><code>informe</code> — landscape + repeatable table header.</li>
            <li><code>membrete</code>, <code>pie_solo</code>, <code>carta_us</code> — PhpWord header/footer and LETTER size.</li>
            <li><code>tablas_avanzado</code> vs <code>tablas_sin_repeat</code> — <code>tables.repeat_header_row</code>.</li>
            <li><code>imagen_ancha</code> — <code>images.max_width</code> / remote images.</li>
            <li><code>densidad</code> — long text/tables + stress filename.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <form method="post" action="{{ path('demo_home') }}" id="export-form" class="mb-4">
    <fieldset class="border rounded p-3 mb-3">
      <legend class="float-none w-auto px-2 fs-6">Converter method</legend>
      {% for key, desc in api_methods %}
        <div class="form-check">
          <input class="form-check-input" type="radio" name="api" id="api-{{ key }}" value="{{ key }}" {% if key == 'convertWithProfile' %}checked{% endif %}>
          <label class="form-check-label" for="api-{{ key }}"><code>{{ key }}</code> — {{ desc }}</label>
        </div>
      {% endfor %}
    </fieldset>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label for="profile" class="form-label">Profile <code>nowo_html_to_word</code></label>
        <select class="form-select" id="profile" name="profile" required>
          {% for p in profiles %}
            <option value="{{ p }}" {% if p == 'default' %}selected{% endif %}>{{ p }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <input type="hidden" name="preset" id="preset-field" value="">
        <button type="submit" class="btn btn-primary">Download .docx</button>
      </div>
    </div>

    <label class="form-label">Presets (fill the textarea)</label>
    <div class="d-flex flex-wrap gap-2 mb-2">
      {% for id, _html in presets %}
        <button type="button" class="btn btn-outline-secondary btn-sm" data-load-preset="{{ id }}" title="{{ preset_meta[id].stack|default('') }}">{{ id }}</button>
      {% endfor %}
    </div>

    <label for="html-field" class="form-label">HTML</label>
    <textarea class="form-control font-monospace small" id="html-field" name="html" rows="18" spellcheck="false">&lt;p&gt;Paste HTML or click a preset.&lt;/p&gt;</textarea>
    <p class="form-text">
      When you load a preset, the suggested profile can be applied from the table below (button tooltip = relevant stack layer).
    </p>

    <div class="table-responsive">
      <table class="table table-sm table-bordered caption-top">
        <caption class="text-dark">Preset → suggested profile + stack note</caption>
        <thead class="table-light">
          <tr><th>Preset</th><th>Suggested profile</th><th>Stack / libraries</th></tr>
        </thead>
        <tbody class="small">
          {% for id, meta in preset_meta %}
            <tr>
              <td><code>{{ id }}</code></td>
              <td><code>{{ meta.profile }}</code></td>
              <td>{{ meta.stack }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </form>

  <script>
    const DEMO_PRESETS = {{ presets_json|raw }};
    document.querySelectorAll('[data-load-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-load-preset');
        const ta = document.getElementById('html-field');
        const pf = document.getElementById('preset-field');
        ta.value = DEMO_PRESETS[id] || '';
        pf.value = '';
        const sug = {{ preset_meta_json|raw }};
        if (sug[id] && sug[id].profile) {
          const sel = document.getElementById('profile');
          const opt = Array.from(sel.options).find(function (o) { return o.value === sug[id].profile; });
          if (opt) { sel.value = sug[id].profile; }
        }
      });
    });
  </script>
{% endblock %}
